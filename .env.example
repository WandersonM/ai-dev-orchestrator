# Chaves - nunca faça commit das chaves reais
OPENAI_API_KEY=
GEMINI_API_KEY=

# Roteamento por papel/tarefa
AIDEV_REFINEMENT_PROVIDER=GEMINI
AIDEV_REFINEMENT_MODEL=gemini-3.7-flash

AIDEV_ARCHITECTURE_PROVIDER=OPENAI
AIDEV_ARCHITECTURE_MODEL=gpt-5.6-sol

AIDEV_BACKEND_PROVIDER=OPENAI
AIDEV_BACKEND_MODEL=gpt-5.6-sol

AIDEV_FRONTEND_PROVIDER=GEMINI
AIDEV_FRONTEND_MODEL=gemini-3.7-flash

AIDEV_QA_PROVIDER=GEMINI
AIDEV_QA_MODEL=gemini-3.7-flash

AIDEV_REVIEW_PROVIDER=OPENAI
AIDEV_REVIEW_MODEL=gpt-5.6-sol

AIDEV_SECURITY_PROVIDER=OPENAI
AIDEV_SECURITY_MODEL=gpt-5.6-sol

AIDEV_INTEGRATION_PROVIDER=OPENAI
AIDEV_INTEGRATION_MODEL=gpt-5.6-sol

AIDEV_RELEASE_PROVIDER=OPENAI
AIDEV_RELEASE_MODEL=gpt-5.6-sol

AIDEV_DOMAIN_VALIDATION_PROVIDER=GEMINI
AIDEV_DOMAIN_VALIDATION_MODEL=gemini-3.7-flash

# Limites dos agentes e orquestração
AIDEV_PLANNING_MAX_ROUNDS=3
AIDEV_ARCHITECT_MAX_STEPS=12
AIDEV_BACKEND_MAX_STEPS=20
AIDEV_FRONTEND_MAX_STEPS=20
AIDEV_QA_MAX_STEPS=16
AIDEV_INTEGRATION_MAX_STEPS=12
AIDEV_REVIEW_MAX_STEPS=10
AIDEV_REVIEW_MAX_ITERATIONS=3
AIDEV_SECURITY_MAX_STEPS=10
AIDEV_DOMAIN_GUARDIAN_MAX_STEPS=10
AIDEV_RELEASE_MAX_STEPS=8
AIDEV_MAX_PARALLEL=3

# MCP - servidores individuais são configurados em application-local.yml
AIDEV_MCP_ENABLED=false
AIDEV_MCP_REQUEST_TIMEOUT=30s

# Publicação no GitHub - desabilitada por padrão
AIDEV_GITHUB_PUBLISH_ENABLED=false
AIDEV_GITHUB_TOKEN=
AIDEV_GITHUB_API_BASE_URL=https://api.github.com
AIDEV_GITHUB_BASE_BRANCH=main

# Opcional: sobrescrever endpoints dos LLMs
OPENAI_BASE_URL=https://api.openai.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

AIDEV_WORKSPACE_ROOT=./workspace
